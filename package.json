{
  "name": "skytrace",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "oxlint --deny-warnings src tests scripts vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:og": "bun run scripts/generate-og.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run lint && bun run format:check && bun run test && bun run build"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.4",
    "@atcute/bluesky": "^4.0.20",
    "@atcute/client": "^5.1.1",
    "@atcute/identity": "^2.0.0",
    "@atcute/identity-resolver": "^2.0.0",
    "@atcute/lexicons": "^2.1.0",
    "@atcute/microcosm": "^2.0.2",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-query": "^5.87.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "satori": "^0.33.4",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "bun": "1.3.13"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  }
}
