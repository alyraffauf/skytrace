{
  "name": "skytrace",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "oxlint --deny-warnings src tests scripts vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:og": "bun run scripts/generate-og.tsx",
    "generate:icons": "bun run scripts/generate-icons.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run lint && bun run format:check && bun run test && bun run build"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.4",
    "@atcute/bluesky": "^4.0.24",
    "@atcute/bluesky-richtext-segmenter": "^3.0.2",
    "@atcute/cbor": "^2.3.8",
    "@atcute/cid": "^2.5.0",
    "@atcute/client": "^5.1.2",
    "@atcute/identity": "^2.0.2",
    "@atcute/identity-resolver": "^2.0.3",
    "@atcute/lexicons": "^2.1.1",
    "@atcute/microcosm": "^2.0.2",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@noble/hashes": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@resvg/resvg-js": "^2.6.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "satori": "^0.33.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  }
}
