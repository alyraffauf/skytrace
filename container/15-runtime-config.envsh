#!/bin/sh

if [ "${SKYTRACE_IGNORE_NO_UNAUTHENTICATED:-}" = "true" ]; then
  export SKYTRACE_IGNORE_NO_UNAUTHENTICATED_VALUE=true
else
  export SKYTRACE_IGNORE_NO_UNAUTHENTICATED_VALUE=false
fi

is_valid_did() {
  case "$1" in
    *[!A-Za-z0-9._:%-]*) return 1 ;;
  esac
  printf '%s' "$1" | grep -Eq '^did:[a-z0-9]+:[A-Za-z0-9._:%-]+(:[A-Za-z0-9._:%-]+)*$'
}

if is_valid_did "${SKYTRACE_BLOCK_TARGET_DID:-}"; then
  export SKYTRACE_BLOCK_TARGET_DID_VALUE="\"${SKYTRACE_BLOCK_TARGET_DID}\""
else
  export SKYTRACE_BLOCK_TARGET_DID_VALUE=null
fi

# Validate each comma-separated DID before embedding it in runtime JavaScript.
export SKYTRACE_HIDDEN_DIDS_VALUE="$(printf '%s' "${SKYTRACE_HIDDEN_DIDS:-}" | awk '
  BEGIN { RS = ","; printf "[" }
  {
    gsub(/^[[:space:]]+|[[:space:]]+$/, "")
    if ($0 ~ /^did:[a-z0-9]+:[A-Za-z0-9._:%-]+(:[A-Za-z0-9._:%-]+)*$/) {
      printf "%s\"%s\"", separator, $0
      separator = ","
    }
  }
  END { printf "]" }
')"

# Emit a JSON integer within the optional maximum or JavaScript's safe range.
json_count() {
  if printf '%s' "$1" | grep -Eq '^(0|[1-9][0-9]{0,15})$'; then
    if [ "$1" -le "${2:-9007199254740991}" ]; then
      printf '%s' "$1"
      return
    fi
  fi
  printf 'null'
}

export SKYTRACE_MIN_LIST_BLOCKING_VALUE="$(json_count "${SKYTRACE_MIN_LIST_BLOCKING:-}")"
export SKYTRACE_DONATE_REMINDER_DAYS_VALUE="$(json_count "${SKYTRACE_DONATE_REMINDER_DAYS:-}" 400)"
