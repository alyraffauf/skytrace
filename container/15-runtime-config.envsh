#!/bin/sh

if [ "${SKYTRACE_IGNORE_NO_UNAUTHENTICATED:-}" = "true" ]; then
  export SKYTRACE_IGNORE_NO_UNAUTHENTICATED_VALUE=true
else
  export SKYTRACE_IGNORE_NO_UNAUTHENTICATED_VALUE=false
fi

if printf '%s' "${SKYTRACE_BLOCK_TARGET_DID:-}" | grep -Eq '^did:[a-z0-9]+:[A-Za-z0-9._:%-]+(:[A-Za-z0-9._:%-]+)*$'; then
  export SKYTRACE_BLOCK_TARGET_DID_VALUE="\"${SKYTRACE_BLOCK_TARGET_DID}\""
else
  export SKYTRACE_BLOCK_TARGET_DID_VALUE=null
fi

# Validate each comma-separated DID before embedding it in runtime JavaScript.
export SKYTRACE_HIDDEN_DIDS_VALUE="$(printf '%s' "${SKYTRACE_HIDDEN_DIDS:-}" | awk '
  BEGIN { RS = ","; printf "[" }
  {
    gsub(/^[[:space:]]+|[[:space:]]+$/, "")
    if ($0 ~ /^did:[a-z0-9]+:[A-Za-z0-9._:%-]+(:[A-Za-z0-9._:%-]+)*$/) {
      printf "%s\"%s\"", separator, $0
      separator = ","
    }
  }
  END { printf "]" }
')"

# Emit a JSON integer only for whole counts within JavaScript's safe range.
export MIN_LIST_BLOCKING_VALUE=null
if printf '%s' "${MIN_LIST_BLOCKING:-}" | grep -Eq '^(0|[1-9][0-9]{0,15})$'; then
  if [ "$MIN_LIST_BLOCKING" -le 9007199254740991 ]; then
    export MIN_LIST_BLOCKING_VALUE="$MIN_LIST_BLOCKING"
  fi
fi
